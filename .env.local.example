# Supabase 專案設定（Project Settings → API）
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# service_role key：只在伺服器端使用，絕對不可加 NEXT_PUBLIC_ 前綴
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# 帳號合成信箱用的網域（使用者不會看到，但必須是合法網域格式）
NEXT_PUBLIC_ACCOUNT_EMAIL_DOMAIN=checkin.local
